+// A locked letter that is not a destination is still a lesson.
+// S and O say how they join into home. Anything else in the
+// alphabet says its own marks. A word that is not one symbol
+// and not S.O.S is not a lesson.
+export function morseLesson(text) {
+  if (text === "SOS") {
+    return {
+      kind: "home",
+      text: "S.O.S — three short, three long, three short. That brings you home.",
+    };
+  }
+  if (typeof text !== "string" || text.length !== 1 || !MORSE[text]) return null;
+  const pat = MORSE[text];
+  if (text === "S") {
+    return {
+      kind: "practice", symbol: "S",
+      text: `S is three dots (${pat}). Next is O, three dashes. S, O, S brings you home.`,
+    };
+  }
+  if (text === "O") {
+    return {
+      kind: "practice", symbol: "O",
+      text: `O is three dashes (${pat}). With S on either side, that is home.`,
+    };
+  }
+  return { kind: "practice", symbol: text, text: `${text} is ${pat}.` };
+}
+
 export function isSos(pattern) {
   const d = decodeMorse(pattern);
   return !!(d && d.words.length === 1 && d.words[0] === "SOS");
